<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Hawkynt.ProcessManager.Tests</AssemblyName>
    <RootNamespace>Hawkynt.ProcessManager.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!-- Every probe is referenced from every OS: the parsers are tested against recorded fixtures
       (PRD 9.1, 9.4), so the Linux parser is exercised on the Windows CI leg and vice versa. -->
  <ItemGroup>
    <ProjectReference Include="..\ProcessManager.Core\ProcessManager.Core.csproj" />
    <ProjectReference Include="..\ProcessManager.Platform.Linux\ProcessManager.Platform.Linux.csproj" />
    <ProjectReference Include="..\ProcessManager.Platform.MacOS\ProcessManager.Platform.MacOS.csproj" />
    <ProjectReference Include="..\ProcessManager.Platform.Windows\ProcessManager.Platform.Windows.csproj" />
    <ProjectReference Include="..\ProcessManager.Ui.Terminal\ProcessManager.Ui.Terminal.csproj" />
    <!-- The desktop binder is testable without a display: the tree control is owner-drawn and its
         node collection works unrealized, which is what makes the "the window showed nothing"
         regression catchable in a unit test rather than only in the CI screenshot leg. -->
    <ProjectReference Include="..\ProcessManager.Ui.Desktop\ProcessManager.Ui.Desktop.csproj" />
  </ItemGroup>

</Project>
